APP_NAME=Laravel
SUPPLIER_PERFORMANCE_MIN_DELIVERIES=
SUPPLIER_PERFORMANCE_WEIGHT_ON_TIME=
SUPPLIER_PERFORMANCE_WEIGHT_FULFILLMENT=
SUPPLIER_PERFORMANCE_WEIGHT_QA_ACCEPTANCE=
SUPPLIER_PERFORMANCE_WEIGHT_DISCREPANCY_FREE=
SUPPLIER_PERFORMANCE_RECOGNITION_TIERS=[]
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Origins allowed to call the API from a browser (comma separated).
# Leave unset locally: the Vite dev server origins are trusted automatically
# while APP_ENV is local. In production set this to the deployed frontend URL.
CORS_ALLOWED_ORIGINS=

# Public URL of the frontend. Account activation links in invitation emails
# point to {FRONTEND_URL}/activate-account. Set to the deployed frontend URL.
FRONTEND_URL=http://localhost:5173
SUPPLIER_PORTAL_LINK_EXPIRATION_DAYS=30
SUPPLIER_PORTAL_SESSION_EXPIRATION_MINUTES=60

# Account invitations: link lifetime and minimum wait between resends.
INVITATION_EXPIRATION_HOURS=48
INVITATION_RESEND_COOLDOWN_SECONDS=60

# Login email OTP (second step after the password): code lifetime, wrong-code
# attempts per challenge, wait between resends, resends per challenge, and how
# many challenges one account may start per 15 minutes.
LOGIN_OTP_EXPIRATION_MINUTES=5
LOGIN_OTP_MAX_ATTEMPTS=5
LOGIN_OTP_RESEND_COOLDOWN_SECONDS=60
LOGIN_OTP_MAX_RESENDS=5
LOGIN_OTP_MAX_CHALLENGES_PER_WINDOW=5

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=smartchain_db
DB_USERNAME=postgres
DB_PASSWORD=admin123

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Lifetime of Sanctum API tokens in minutes (default 480 = 8 hours).
SANCTUM_EXPIRATION_MINUTES=480

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Transactional email (login OTP, account invitations).
# Local development: "log" writes the email to storage/logs instead of sending.
# Production (Railway): "brevo" delivers over the Brevo HTTPS API, because
# outbound SMTP port 587 is blocked on Railway's lower plans.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Brevo HTTPS transactional API. Required when MAIL_MAILER=brevo.
# Set these in the deployment environment only; never commit real values.
# BREVO_SENDER_EMAIL must be a sender Brevo has verified.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SmartChain

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
